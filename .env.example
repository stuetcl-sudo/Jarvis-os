APP_NAME=Jarvis-os
SAFE_MODE=true
ALLOW_RESTART_STOPPED=true
WORKER_ENABLED=true
WORKER_INTERVAL_SECONDS=60
AUTO_START_FAILURE_LIMIT=3
AUTO_START_FAILURE_WINDOW_MINUTES=30
DOCKER_VERIFY_TIMEOUT_SECONDS=15
DOCKER_VERIFY_INTERVAL_SECONDS=1

# Local authentication. Keep false only for local HTTP.
# Set AUTH_COOKIE_SECURE=true whenever Jarvis-os is served through HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=12
AUTH_WALL_SESSION_DAYS=30
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_MINUTES=15

# Optional read-only Home Assistant integrations.
HOME_ASSISTANT_URL=""
HOME_ASSISTANT_TOKEN=""
HOME_ASSISTANT_WEATHER_ENTITY=""
HOME_ASSISTANT_TIMEOUT_SECONDS=5
WEATHER_CACHE_SECONDS=300
WEATHER_STALE_SECONDS=3600

# Format: calendar entity|display label|supported color, separated by commas.
# Example: HOME_ASSISTANT_CALENDARS=calendar.example_green|Green calendar|green,calendar.example_blue|Blue calendar|blue,calendar.example_violet|Violet calendar|violet,calendar.example_yellow|Shared calendar|yellow
HOME_ASSISTANT_CALENDARS=""
CALENDAR_LOOKAHEAD_DAYS=7
CALENDAR_CACHE_SECONDS=300
CALENDAR_STALE_SECONDS=3600
CALENDAR_MAX_EVENTS=40

# Child routine local date and Wednesday/Sunday bath logic.
ROUTINE_TIMEZONE=Europe/Copenhagen

CRITICAL_SERVICES=jarvis-os
PROTECTED_CONTAINERS=jarvis-os
OPTIONAL_SERVICES=
IGNORED_SERVICES=

ALLOWED_RESTART_CONTAINERS=
ALLOWED_AUTO_START_CONTAINERS=

# Optional generic asset dependency examples:
# ASSET_DEPENDENCIES=docker:example-app>docker:example-network,docker:worker>docker:database
ASSET_DEPENDENCIES=

CPU_WARN_PERCENT=90
MEMORY_WARN_PERCENT=90
SWAP_WARN_PERCENT=80
DISK_WARN_PERCENT=85

BASELINE_MIN_SAMPLES=20
BASELINE_MAX_STEP_PERCENT=2
ANOMALY_RAM_DELTA_PERCENT=20
ANOMALY_SWAP_DELTA_PERCENT=20
DISK_TREND_DELTA_PERCENT=2

OBSERVATIONS_RETENTION_DAYS=30
WORKER_CHECKS_RETENTION_DAYS=30
ACTION_LOG_RETENTION_DAYS=90
RESOLVED_INCIDENTS_RETENTION_DAYS=90

DB_PATH=/data/jarvis.db
