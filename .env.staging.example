APP_NAME=Jarvis-os Staging
SAFE_MODE=false
ALLOW_RESTART_STOPPED=false
WORKER_ENABLED=false
WORKER_INTERVAL_SECONDS=60

AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=1
AUTH_WALL_SESSION_DAYS=1
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_MINUTES=15

HOME_ASSISTANT_URL=""
HOME_ASSISTANT_TOKEN=""
HOME_ASSISTANT_WEATHER_ENTITY=""
HOME_ASSISTANT_UV_ENTITY=""
HOME_ASSISTANT_CALENDARS=""
HOME_ASSISTANT_MEAL_CALENDAR=""
HOME_ASSISTANT_TASK_LISTS=""
