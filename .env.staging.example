ROUTINE_TIMEZONE=Europe/Copenhagen
OPTIONAL_SERVICES=
IGNORED_SERVICES=
ALLOWED_RESTART_CONTAINERS=
ALLOWED_AUTO_START_CONTAINERS=
ASSET_DEPENDENCIES=

DB_PATH=/data/jarvis-staging.db
